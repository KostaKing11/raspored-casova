<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: lets CI / adb drive the alarm machinery. -->
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver"
            xmlns:tools="http://schemas.android.com/tools">
            <intent-filter>
                <action android:name="com.kostaking.raspored.debug.TEST_ALARM" />
                <action android:name="com.kostaking.raspored.debug.DUMP" />
                <action android:name="com.kostaking.raspored.debug.SKIP_ONBOARDING" />
                <action android:name="com.kostaking.raspored.debug.RESCHEDULE" />
                <action android:name="com.kostaking.raspored.debug.SET_MODE" />
                <action android:name="com.kostaking.raspored.debug.ADD_EVENT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
